{
    "name": "wpo/woocommerce-orders-invoice-pdf",
    "description": "WooCommerce PDF invoices, packing slips and pro documents — standalone merged plugin",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "dompdf/dompdf": "^2.0",
        "mpdf/mpdf": "^8.3",
        "composer/installers": "^1.0 || ^2.0",
        "mpdf/qrcode": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "brain/monkey": "^2.6",
        "brianhenryie/strauss": "^0.19"
    },
    "autoload": {
        "files": [
            "woi-pdf-functions.php",
            "includes/Visual/functions.php"
        ],
        "psr-4": {
            "WOI\\PDF\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WOI\\PDF\\Tests\\": "tests/"
        }
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor/strauss",
            "namespace_prefix": "WOI\\PDF\\Vendor\\",
            "classmap_prefix": "WOI_PDF_",
            "constant_prefix": "WOI_PDF_",
            "packages": [
                "dompdf/dompdf",
                "mpdf/mpdf",
                "mpdf/qrcode"
            ],
            "exclude_from_copy": {
                "file_patterns": ["/.*\\.txt/"]
            }
        }
    },
    "scripts": {
        "strauss": "vendor/bin/strauss",
        "mpdf-assets": "@php bin/strauss-mpdf-assets.php",
        "post-install-cmd": ["@strauss", "@mpdf-assets"],
        "post-update-cmd": ["@strauss", "@mpdf-assets"],
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "process-timeout": 0,
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
