{
    "name": "wpo/woocommerce-orders-invoice-pdf",
    "description": "WooCommerce PDF invoices, packing slips and pro documents — standalone merged plugin",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "dompdf/dompdf": "^2.0",
        "composer/installers": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "brain/monkey": "^2.6",
        "brianhenryie/strauss": "^0.19"
    },
    "autoload": {
        "psr-4": {
            "WOI\\PDF\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WOI\\PDF\\Tests\\": "tests/"
        }
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor/strauss",
            "namespace_prefix": "WOI\\PDF\\Vendor\\",
            "classmap_prefix": "WOI_PDF_",
            "constant_prefix": "WOI_PDF_",
            "packages": [
                "dompdf/dompdf"
            ],
            "exclude_from_copy": {
                "file_patterns": ["/.*\\.txt/"]
            }
        }
    },
    "scripts": {
        "strauss": "vendor/bin/strauss",
        "post-install-cmd": ["@strauss"],
        "post-update-cmd": ["@strauss"],
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
